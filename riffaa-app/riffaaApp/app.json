{
  "expo": {
    "name": "Riffaa",
    "slug": "riffaa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "riffaaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#273444",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mahfoudhn.riffaaapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#273444",
          "dark": {
            "backgroundColor": "#273444"
          }
        }
      ],
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "تحتاج منصة رفعة للوصول إلى الكاميرا لمشاركة الفيديو في البث المباشر.",
          "microphonePermission": "تحتاج منصة رفعة إلى المايكروفون لتتمكن من التفاعل الصوتي."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-web-browser",
      "expo-status-bar",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "googleWebClientId": "",
      "eas": {
        "projectId": "d1088bb5-b1ce-4eaf-878f-cbedfa923c48"
      }
    }
  }
}
